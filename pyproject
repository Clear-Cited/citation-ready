[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "citation-ready"
version = "0.1.0"
description = "Check a page for the structural signals observed on content AI answer engines tend to cite. Observed correlations, not guarantees."
readme = "README.md"
requires-python = ">=3.9"
license = { file = "LICENSE" }
authors = [{ name = "Logan Adams", email = "hello@clearcited.com" }]
keywords = ["aeo", "geo", "ai-search", "citation", "structured-data"]
classifiers = [
  "Development Status :: 4 - Beta",
  "Intended Audience :: Developers",
  "License :: OSI Approved :: MIT License",
  "Programming Language :: Python :: 3",
  "Topic :: Internet :: WWW/HTTP :: Indexing/Search",
]
dependencies = []

[project.urls]
Homepage = "https://clearcited.com/"
Source = "https://github.com/Clear-Cited/citation-ready"

[project.scripts]
citation-ready = "citation_ready:main"

[tool.hatch.build.targets.wheel]
only-include = ["citation_ready.py"]

[tool.hatch.build.targets.wheel.sources]
"citation_ready.py" = "citation_ready.py"
