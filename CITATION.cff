    given-names: "Logan"
    orcid: "https://orcid.org/0009-0009-1235-9479"
    affiliation: "Clear Cited"
repository-code: "https://github.com/Clear-Cited/citation-ready"
url: "https://clearcited.com/"
license: MIT
keywords:
